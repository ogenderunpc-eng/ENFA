{
  "entities": {
    "Student": {
      "title": "Student",
      "description": "Represents a student and their academic records.",
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "number": { "type": "string" },
        "email": { "type": "string" },
        "avatar": { "type": "string" },
        "class": { "type": "string" },
        "role": { "type": "string" },
        "attendance": { "type": "number" },
        "status": { "type": "string" },
        "grades": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "subject": { "type": "string" },
              "value": { "type": "number" },
              "date": { "type": "string" }
            }
          }
        },
        "ktsResults": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": { "type": "string" },
              "examName": { "type": "string" },
              "date": { "type": "string" },
              "score": { "type": "number" }
            }
          }
        },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["name", "number"]
    },
    "Message": {
      "title": "Message",
      "description": "A communication message between users.",
      "type": "object",
      "properties": {
        "sender": { "type": "string" },
        "senderRole": { "type": "string" },
        "content": { "type": "string" },
        "time": { "type": "string" },
        "recipientId": { "type": "string" },
        "createdAt": { "type": "string" }
      },
      "required": ["sender", "content", "time", "recipientId"]
    },
    "Class": {
      "title": "Class",
      "description": "A scheduled class session.",
      "type": "object",
      "properties": {
        "title": { "type": "string" },
        "time": { "type": "string" },
        "location": { "type": "string" },
        "classGroup": { "type": "string" },
        "image": { "type": "string" },
        "status": { "type": "string", "enum": ["ongoing", "next"] }
      },
      "required": ["title", "time"]
    },
    "Attendance": {
      "title": "Attendance",
      "description": "Daily attendance record for a student.",
      "type": "object",
      "properties": {
        "studentId": { "type": "string" },
        "studentName": { "type": "string" },
        "date": { "type": "string" },
        "status": { "type": "string", "enum": ["present", "absent"] },
        "classId": { "type": "string" }
      },
      "required": ["studentId", "date", "status"]
    },
    "Notification": {
      "title": "Notification",
      "description": "Alerts for new messages, exams, or performance changes.",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "title": { "type": "string" },
        "content": { "type": "string" },
        "type": { "type": "string", "enum": ["message", "exam", "performance", "system"] },
        "isRead": { "type": "boolean" },
        "createdAt": { "type": "string", "format": "date-time" },
        "link": { "type": "string" }
      },
      "required": ["userId", "title", "content", "type", "createdAt"]
    },
    "Homework": {
      "title": "Homework",
      "description": "Assignments given by teachers to students/classes.",
      "type": "object",
      "properties": {
        "title": { "type": "string" },
        "description": { "type": "string" },
        "deadline": { "type": "string", "format": "date" },
        "teacherId": { "type": "string" },
        "classId": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["title", "description", "deadline", "teacherId", "classId", "createdAt"]
    },
    "Announcement": {
      "title": "Announcement",
      "description": "Public announcements for all users.",
      "type": "object",
      "properties": {
        "title": { "type": "string" },
        "content": { "type": "string" },
        "date": { "type": "string" },
        "teacherId": { "type": "string" }
      },
      "required": ["title", "content", "date", "teacherId"]
    },
    "Exam": {
      "title": "Exam",
      "description": "Represents an exam with a PDF attachment.",
      "type": "object",
      "properties": {
        "sinav_adi": { "type": "string" },
        "ders": { "type": "string" },
        "toplam_soru": { "type": "number" },
        "tarih": { "type": "string" },
        "pdf_data": { "type": "string", "description": "Base64 encoded PDF content" },
        "pdf_name": { "type": "string" },
        "teacherId": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["sinav_adi", "ders", "toplam_soru", "pdf_data", "teacherId"]
    },
    "ExamResult": {
      "title": "ExamResult",
      "description": "Represents a student's result on a specific exam.",
      "type": "object",
      "properties": {
        "sinav_id": { "type": "string" },
        "talebe_id": { "type": "string" },
        "talebe_isim": { "type": "string" },
        "dogru": { "type": "number" },
        "yanlis": { "type": "number" },
        "bos": { "type": "number" },
        "net": { "type": "number" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["sinav_id", "talebe_isim", "dogru", "yanlis", "bos", "net"]
    },
    "CalendarEvent": {
      "title": "CalendarEvent",
      "description": "Represents an exam or event on the shared calendar.",
      "type": "object",
      "properties": {
        "etkinlik_adi": { "type": "string" },
        "tur": { "type": "string", "enum": ["Deneme", "Okul", "Yazılı", "Performans", "Sınav"] },
        "tarih": { "type": "string", "format": "date" },
        "teacherId": { "type": "string" }
      },
      "required": ["etkinlik_adi", "tur", "tarih"]
    }
  },
  "firestore": {
    "/talebe_sonuclari/{resultId}": {
      "schema": "ExamResult",
      "description": "Collection of student results for exams."
    },
    "/sinavlar/{examId}": {
      "schema": "Exam",
      "description": "Collection of exams with PDF booklets."
    },
    "/attendance/{attendanceId}": {
      "schema": "Attendance",
      "description": "Daily attendance logs."
    },
    "/announcements/{announcementId}": {
      "schema": "Announcement",
      "description": "Global announcements."
    },
    "/homework/{homeworkId}": {
      "schema": "Homework",
      "description": "Homework assignments."
    },
    "/students/{studentId}": {
      "schema": "Student",
      "description": "Collection of students."
    },
    "/messages/{messageId}": {
      "schema": "Message",
      "description": "Chat and broadcast messages."
    },
    "/classes/{classId}": {
      "schema": "Class",
      "description": "Schedule of classes."
    },
    "/attendance/{attendanceId}": {
      "schema": "Attendance",
      "description": "Daily attendance records."
    },
    "/notifications/{notificationId}": {
      "schema": "Notification",
      "description": "User specific notifications."
    },
    "/yoneticiler/{adminId}": {
      "schema": "Message",
      "description": "Admin users collection."
    },
    "/takvim_etkinlikleri/{eventId}": {
      "schema": "CalendarEvent",
      "description": "Shared exam calendar events."
    }
  }
}
