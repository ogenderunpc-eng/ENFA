rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 0. Default Deny
    match /{document=**} {
      allow read, write: if false;
    }

    // 3. Global Helpers
    function isSignedIn() { 
      return request.auth != null; 
    }

    function isAdmin() { 
      return isSignedIn() && (
        request.auth.token.get('email', '') == 'ogenderunpc@gmail.com' ||
        request.auth.token.get('email', '') == 'ogretmen@example.com' ||
        exists(/databases/$(database)/documents/yoneticiler/$(request.auth.uid))
      ); 
    }

    function isTeacher() { 
      return isSignedIn() && (
        request.auth.token.get('email', '') == 'ogretmen@example.com' ||
        request.auth.token.get('email', '') == 'ogenderunpc@gmail.com' ||
        exists(/databases/$(database)/documents/teachers/$(request.auth.uid)) ||
        isAdmin()
      );
    }

    function isVerified() { 
      return isSignedIn();
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function incoming() { return request.resource.data; }
    function existing() { return resource.data; }
    function isValidId(id) { 
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$'); 
    }

    // 2. Validation Blueprints
    function isValidStudent(data) {
      return data.keys().hasAll(['name', 'number']) &&
             data.name is string && data.name.size() <= 200 &&
             data.number is string && data.number.size() <= 64 &&
             (!('email' in data) || (data.email is string && data.email.size() <= 128)) &&
             (!('class' in data) || (data.class is string && data.class.size() <= 50)) &&
             (!('avatar' in data) || (data.avatar is string && data.avatar.size() <= 1000)) &&
             (!('role' in data) || (data.role is string && data.role.size() <= 50)) &&
             (!('attendance' in data) || (data.attendance is number)) &&
             (!('status' in data) || (data.status is string && data.status.size() <= 20)) &&
             (!('grades' in data) || (data.grades is list && data.grades.size() <= 500)) &&
             (!('ktsResults' in data) || (data.ktsResults is list && data.ktsResults.size() <= 500)) &&
             (!('createdAt' in data) || (data.createdAt is string && data.createdAt.size() <= 64)) &&
             (!('updatedAt' in data) || (data.updatedAt is string && data.updatedAt.size() <= 64));
    }

    function isValidTeacher(data) {
      return data.keys().hasAll(['name', 'email']) &&
             data.name is string && data.name.size() <= 200 &&
             data.email is string && data.email.size() <= 128 &&
             (!('role' in data) || (data.role == 'teacher'));
    }

    function isValidMessage(data) {
      return data.keys().hasAll(['sender', 'content', 'recipientId']) &&
             data.sender is string && data.sender.size() <= 200 &&
             data.content is string && data.content.size() <= 3000 &&
             data.recipientId is string && data.recipientId.size() <= 128 &&
             (!('senderId' in data) || (data.senderId == request.auth.uid)) &&
             (data.get('time', '') is string && data.get('time', '').size() <= 100) &&
             (data.get('senderRole', '') is string && data.get('senderRole', '').size() <= 50) &&
             (data.get('createdAt', '') is string && data.get('createdAt', '').size() <= 100);
    }

    function isValidClass(data) {
        return data.keys().hasAll(['title', 'time']) &&
               data.title is string && data.title.size() <= 200 &&
               data.time is string && data.time.size() <= 100;
    }

    function isValidAttendance(data) {
      return data.keys().hasAll(['classId', 'date', 'records', 'teacherId']) &&
             data.classId is string && data.classId.size() <= 128 &&
             data.date is string && data.date.size() <= 100 &&
             data.records is map &&
             data.teacherId is string && data.teacherId.size() <= 128;
    }

    function isValidNotification(data) {
      return data.keys().hasAll(['userId', 'title', 'content', 'type', 'createdAt', 'isRead']) &&
             data.userId is string && data.userId.size() <= 128 &&
             data.title is string && data.title.size() <= 200 &&
             data.content is string && data.content.size() <= 2000 &&
             (data['type'] in ['message', 'exam', 'performance', 'system']) &&
             data.isRead is bool &&
             data.createdAt is string && data.createdAt.size() <= 100;
    }

    function isValidHomework(data) {
      return data.keys().hasAll(['title', 'description', 'deadline', 'teacherId', 'classId', 'createdAt']) &&
             data.title is string && data.title.size() <= 200 &&
             data.description is string && data.description.size() <= 3000 &&
             data.deadline is string && data.deadline.size() <= 100 &&
             data.teacherId is string && data.teacherId.size() <= 128 &&
             data.classId is string && data.classId.size() <= 128 &&
             data.createdAt is string && data.createdAt.size() <= 100;
    }

    function isValidAnnouncement(data) {
      return data.keys().hasAll(['title', 'content', 'date', 'teacherId']) &&
             data.title is string && data.title.size() <= 200 &&
             data.content is string && data.content.size() <= 5000 &&
             data.date is string && data.date.size() <= 100 &&
             data.teacherId is string && data.teacherId.size() <= 128;
    }

    function isValidExam(data) {
      return data.keys().hasAll(['sinav_adi', 'ders', 'toplam_soru', 'pdf_data', 'teacherId']) &&
             data.sinav_adi is string && data.sinav_adi.size() <= 200 &&
             data.ders is string && data.ders.size() <= 50 &&
             data.toplam_soru is number &&
             data.pdf_data is string && data.pdf_data.size() <= 10485760 && 
             (!('pdf_name' in data) || (data.pdf_name is string && data.pdf_name.size() <= 200)) &&
             (!('tarih' in data) || (data.tarih is string && data.tarih.size() <= 100)) &&
             data.teacherId is string && data.teacherId.size() <= 128 &&
             (!('createdAt' in data) || (data.createdAt is string && data.createdAt.size() <= 100));
    }

    function isValidExamResult(data) {
      return data.keys().hasAll(['sinav_id', 'talebe_isim', 'dogru', 'yanlis', 'bos', 'net']) &&
             data.sinav_id is string && data.sinav_id.size() <= 128 &&
             data.talebe_isim is string && data.talebe_isim.size() <= 200 &&
             data.dogru is number && data.yanlis is number && data.bos is number && data.net is number &&
             (!('talebe_id' in data) || (data.talebe_id is string && data.talebe_id.size() <= 128)) &&
             (!('createdAt' in data) || (data.createdAt is string && data.createdAt.size() <= 100));
    }

    function isValidCalendarEvent(data) {
      return data.keys().hasAll(['etkinlik_adi', 'tur', 'tarih']) &&
             data.etkinlik_adi is string && data.etkinlik_adi.size() <= 200 &&
             (data.tur in ['Deneme', 'Okul', 'Yazılı', 'Performans', 'Sınav']) &&
             data.tarih is string && data.tarih.size() <= 100 &&
             (!('teacherId' in data) || (data.teacherId is string && data.teacherId.size() <= 128)) &&
             (!('createdAt' in data) || (data.createdAt is string && data.createdAt.size() <= 100));
    }

    // --- Collections ---

    match /talebe_sonuclari/{resultId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && isValidId(resultId) && isValidExamResult(incoming());
      allow update, delete: if isTeacher() && isValidId(resultId);
    }

    match /attendance/{attendanceId} {
      allow read: if isSignedIn() && (isTeacher() || exists(/databases/$(database)/documents/students/$(request.auth.uid)));
      allow create: if isTeacher() && isValidId(attendanceId) && isValidAttendance(incoming());
      allow update: if isTeacher() && isValidId(attendanceId) && resource.data.teacherId == request.auth.uid && isValidAttendance(incoming());
      allow delete: if isTeacher() && isValidId(attendanceId);
    }

    match /homework/{homeworkId} {
      allow read: if isSignedIn();
      allow create: if isTeacher() && isValidId(homeworkId) && isValidHomework(incoming());
      allow update: if isTeacher() && isValidId(homeworkId) && resource.data.teacherId == request.auth.uid && isValidHomework(incoming());
      allow delete: if isTeacher() && isValidId(homeworkId) && resource.data.teacherId == request.auth.uid;
    }

    match /announcements/{announcementId} {
      allow read: if isSignedIn();
      allow create: if isTeacher() && isValidId(announcementId) && isValidAnnouncement(incoming());
      allow update: if isTeacher() && isValidId(announcementId) && resource.data.teacherId == request.auth.uid && isValidAnnouncement(incoming());
      allow delete: if isTeacher() && isValidId(announcementId);
    }

    match /sinavlar/{examId} {
      allow read: if isSignedIn();
      allow create: if isTeacher() && isValidId(examId) && isValidExam(incoming());
      allow update: if isTeacher() && isValidId(examId) && resource.data.teacherId == request.auth.uid && isValidExam(incoming());
      allow delete: if isTeacher() && isValidId(examId) && resource.data.teacherId == request.auth.uid;
    }

    match /students/{studentId} {
      allow list: if isSignedIn() && (
        isTeacher() || 
        request.auth.uid == studentId ||
        resource.data.parentEmail == request.auth.token.email
      );
      allow get: if isSignedIn() && (isTeacher() || request.auth.uid == studentId || resource.data.parentEmail == request.auth.token.email);
      allow create: if (isTeacher() || (isSignedIn() && request.auth.uid == studentId)) && isValidId(studentId) && isValidStudent(incoming());
      allow update: if (isTeacher() || (isSignedIn() && request.auth.uid == studentId)) && isValidId(studentId) && isValidStudent(incoming());
      allow delete: if isTeacher() && isValidId(studentId);
    }

    match /messages/{messageId} {
      allow list: if isSignedIn() && (
        isTeacher() || 
        resource.data.recipientId == request.auth.uid || 
        resource.data.senderId == request.auth.uid
      );
      allow get: if isSignedIn() && isValidId(messageId) && (
        isTeacher() || 
        resource.data.get('recipientId', '') == request.auth.uid || 
        resource.data.get('senderId', '') == request.auth.uid
      );
      allow create: if isSignedIn() && isValidId(messageId) && isValidMessage(incoming());
      allow update: if false;
      allow delete: if isTeacher() && isValidId(messageId);
    }

    match /classes/{classId} {
      allow read: if isSignedIn();
      allow write: if isTeacher() && isValidId(classId) && isValidClass(incoming());
    }

    match /notifications/{notificationId} {
      allow list: if isSignedIn() && resource.data.get('userId', '') == request.auth.uid;
      allow get: if isSignedIn() && isValidId(notificationId) && resource.data.get('userId', '') == request.auth.uid;
      allow create: if isSignedIn() && isValidId(notificationId) && isValidNotification(incoming());
      allow update: if isSignedIn() && isValidId(notificationId) && isValidNotification(incoming()) && 
                       resource.data.get('userId', '') == request.auth.uid && 
                       incoming().diff(existing()).affectedKeys().hasOnly(['isRead']);
      allow delete: if isSignedIn() && isValidId(notificationId) && resource.data.get('userId', '') == request.auth.uid;
    }

    match /teachers/{teacherId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && isValidId(teacherId) && request.auth.uid == teacherId && isValidTeacher(incoming());
      allow update: if isAdmin() && isValidId(teacherId) && isValidTeacher(incoming());
      allow delete: if isAdmin() && isValidId(teacherId);
    }

    match /yoneticiler/{adminId} {
      allow get: if isSignedIn() && (request.auth.uid == adminId || isAdmin());
      allow list: if isAdmin();
      allow write: if request.auth.token.get('email', '') == 'ogenderunpc@gmail.com' || request.auth.token.get('email', '') == 'ogretmen@example.com';
    }

    match /takvim_etkinlikleri/{eventId} {
      allow read: if isSignedIn();
      allow create: if isTeacher() && isValidId(eventId) && isValidCalendarEvent(incoming());
      allow update: if isTeacher() && isValidId(eventId) && (resource.data.teacherId == request.auth.uid || isAdmin()) && isValidCalendarEvent(incoming());
      allow delete: if isTeacher() && isValidId(eventId) && (resource.data.teacherId == request.auth.uid || isAdmin());
    }
  }
}
